# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Security
BCRYPT_ROUNDS=12

# Session
SESSION_SECRET=generate-a-random-64-character-string-for-production

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_mgmt
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_POOL_MAX=20