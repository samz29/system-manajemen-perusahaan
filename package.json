{
  "name": "company-management-app",
  "version": "1.0.0",
  "description": "Sistem Manajemen Perusahaan - Faktur, Akuntansi, Penggajian, Aset",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "db:migrate": "pg-migrate up --config pg-migrate.config.js",
    "db:rollback": "pg-migrate down --config pg-migrate.config.js",
    "db:create": "pg-migrate create --config pg-migrate.config.js",
    "db:migrate-data": "node scripts/migrate-to-pg.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": [
    "management",
    "invoice",
    "payroll",
    "accounting",
    "indonesia"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "pg": "^8.23.1",
    "pg-migrate": "^2.0.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "vitest": "^2.0.5"
  }
}
